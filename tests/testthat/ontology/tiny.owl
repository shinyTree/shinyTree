<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/tiny.owl#"
     xml:base="http://example.org/tiny.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/tiny.owl"/>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/T_0000001">
        <rdfs:label>entity</rdfs:label>
        <obo:IAO_0000115>Anything at all.</obo:IAO_0000115>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/T_0000002">
        <rdfs:label>material entity</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/T_0000001"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/T_0000003">
        <rdfs:label>cell</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/T_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/T_0000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/T_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/T_0000004">
        <rdfs:label>old cell</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/T_0000005">
        <rdfs:label>tissue part</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/T_0000001"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/T_0000099">
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
</rdf:RDF>
